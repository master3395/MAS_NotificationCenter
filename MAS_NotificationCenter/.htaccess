# Block sensitive paths; allow images, JS, and templates for normal CMSMS delivery.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^vendor(/|$) - [F,L]
</IfModule>

<FilesMatch "^(composer\.(json|lock))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
